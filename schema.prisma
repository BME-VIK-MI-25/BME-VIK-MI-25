datasource db {
  provider = "sqlite"
  url      = "file:database.db"
}

generator client {
  provider = "prisma-client-py"
}

model Auth {
  id        Int     @id @default(autoincrement())
  email     String
  authcode  Int @unique
}

model Invite {
  id Int @id @default(autoincrement())
  inviteeid Int
  inviterid Int
}

model BlacklistedWords {
  id Int @id @default(autoincrement())
  word String
}

model BlacklistedWordCounter {
  id Int @id @default(autoincrement())
  userId Int @unique
  count Int
}

model BannedInviters {
  id Int @id @default(autoincrement())
  userId Int
  BanExpiry DateTime
}